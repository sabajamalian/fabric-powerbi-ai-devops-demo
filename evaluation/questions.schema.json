{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sabajamalian/fabric-powerbi-ai-devops-demo/evaluation/questions.schema.json",
  "title": "Business question set",
  "type": "object",
  "required": ["version", "data_window", "questions"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "data_window": {
      "type": "object",
      "required": ["start", "end", "latest_month", "latest_quarter"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" },
        "latest_month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "latest_quarter": { "type": "string", "pattern": "^\\d{4}-Q[1-4]$" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "paraphrases", "default_interpretation", "answer_columns", "grading", "tolerance", "reference_sql"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^Q\\d{2}$" },
          "question": { "type": "string", "minLength": 10 },
          "paraphrases": { "type": "array", "minItems": 3, "maxItems": 5, "items": { "type": "string" } },
          "default_interpretation": { "type": "string", "minLength": 20 },
          "answer_columns": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
          "grading": {
            "type": "object",
            "required": ["type", "key_columns", "partial"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["table", "ranking", "set"] },
              "key_columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "rank_by": {
                "type": "object",
                "required": ["column", "absolute", "descending"],
                "properties": {
                  "column": { "type": "string" },
                  "absolute": { "type": "boolean" },
                  "descending": { "type": "boolean" }
                }
              },
              "partial": {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "enum": ["row_fraction", "top_key", "any_key", "column_match"] },
                  "min": { "type": "number" },
                  "column": { "type": "string" }
                }
              }
            }
          },
          "tolerance": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
          "reference_sql": { "type": "string" },
          "reference_dax": { "type": "string" }
        }
      }
    }
  }
}
