# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local outputs, tools, and logs (never committed)
out/
.tools/
evaluation/runs/local-*
apm_modules/
# Third-party skills installed by `apm install` (pinned in apm.lock.yaml)
.agents/skills/semantic-model-authoring/

# Power BI Desktop local-only files
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix
*.abf

# Lab site
site/node_modules/
site/dist/
site/.astro/
# Generated by site/scripts/sync-reference.mjs before every check, dev, and build
site/src/content/docs/reference/agents.md
site/src/content/docs/reference/skills.md
site/src/content/docs/reference/prompts.md
site/src/content/docs/reference/business-questions.md
site/src/content/docs/reference/scripts.md
site/src/content/docs/present/expected-results.md

# Editors and OS
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# Secrets that must never be committed
.env
.env.*
!.env.example
*.pfx
*.pem
*.key
