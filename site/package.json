{
  "name": "contoso-pharmacy-lab-site",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Self-paced lab site for the Contoso Pharmacy Copilot lab. Synthetic data only.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync": "node scripts/sync-reference.mjs",
    "check": "node scripts/sync-reference.mjs && node scripts/check-content.mjs",
    "dev": "node scripts/sync-reference.mjs && astro dev",
    "build": "node scripts/sync-reference.mjs && astro build && node scripts/check-dist.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/starlight": "0.42.1",
    "astro": "7.3.2",
    "gray-matter": "4.0.3",
    "mermaid": "11.17.2",
    "sharp": "0.35.4",
    "starlight-links-validator": "0.26.0",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  }
}
